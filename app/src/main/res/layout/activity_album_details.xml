<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="250dp"
    android:id="@+id/idRLContainerPlayer"
    tools:context=".PlayerActivity">
    <RelativeLayout
        android:id="@+id/idPlayerBtnsContainerRL"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true">

        <ImageView
            android:id="@+id/idIVCoverArtBlur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:tint="#48FFFFFF"
            android:scaleType="centerCrop"
            android:src="@drawable/homestu" />

        <!-- Blur Effect, will affect all the elements above-->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/idBlurView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!--Any child View here, TabLayout for example.
            This View will NOT be blurred -->

        </eightbitlab.com.blurview.BlurView>

        <ImageView
            android:id="@+id/idIVPlayerBackBtn"
            android:layout_width="25dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/ic_back2" />

        <ImageView
            android:id="@+id/idIVSearchBtn"
            android:layout_width="25dp"
            android:layout_height="30dp"
            android:layout_marginStart="300dp"
            android:layout_marginTop="32dp"
            android:layout_toEndOf="@+id/idIVPlayerBackBtn"
            android:src="@drawable/ic_search" />

        <ImageView
            android:id="@+id/idIVSortBtn"
            android:layout_width="25dp"
            android:layout_height="30dp"
            android:layout_marginStart="250dp"
            android:layout_marginTop="32dp"
            android:layout_toEndOf="@+id/idIVPlayerBackBtn"
            android:src="@drawable/ic_sort" />

        <TextView
            android:id="@+id/idTVTrackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/idIVPlayerBackBtn"
            android:layout_marginTop="32dp"
            android:layout_toStartOf="@+id/idIVPlayerMenu"
            android:layout_toEndOf="@+id/idIVCoverArt"
            android:maxLines="1"
            android:paddingTop="4dp"
            android:text="@string/track_title"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/idTVArtistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/idTVTrackTitle"
            android:layout_toStartOf="@+id/idIVPlayerMenu"
            android:layout_toEndOf="@+id/idIVCoverArt"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/artist_name"
            android:textColor="@color/black"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/idTVAlbumYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/idTVArtistName"
            android:layout_toStartOf="@+id/idIVPlayerMenu"
            android:layout_toEndOf="@+id/idIVCoverArt"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/artist_name"
            android:textColor="@color/grey_700"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/idIVPlayerMenu"
            android:layout_width="25dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_more" />

        <!-- TODO: I'LL ADD ON SWIPE ACTION FOR NEXT AND PREVIOUS -->
        <!-- This enables RadiusCorners in the image view -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/idIVCoverArt"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_below="@+id/idIVPlayerBackBtn"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="32dp"
            android:background="@color/black"
            android:scaleType="fitXY"
            android:src="@drawable/homestu"
            app:shapeAppearanceOverlay="@style/roundedCornersImageView2" />

        <Button
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:layout_below="@+id/idIVCoverArt"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:text="PLAY"
            android:textColor="@color/white"
            android:backgroundTint="@color/pink_700"/>

        </RelativeLayout>

    </RelativeLayout>

</RelativeLayout>