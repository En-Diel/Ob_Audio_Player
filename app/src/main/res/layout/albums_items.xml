<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="280dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/idAlbumItems"
    android:layout_margin="6dp"
    app:cardCornerRadius="10dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/idAlbumRelativeLayout">

        <ImageView
            android:id="@+id/idAlbumArtWork"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp"
            android:src="@drawable/ic_headphones" />

        <ImageView
            android:id="@+id/idAlbumPlayBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignBottom="@+id/idAlbumArtWork"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="120dp"
            android:src="@drawable/ic_play" />

        <TextView
            android:id="@+id/idAlbumTitle"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_above="@+id/idArtistName"
            android:layout_alignParentStart="true"
            android:layout_marginStart="0dp"
            android:text="Album Title"
            android:textSize="16sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_toStartOf="@+id/idMenuAlbumOptions"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/idArtistName"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="0dp"
            android:layout_marginBottom="10dp"
            android:text="Artist Name"
            android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_toStartOf="@+id/idMenuAlbumOptions"
            android:textColor="@color/ActionBarTextColor" />

        <ImageView
            android:id="@+id/idMenuAlbumOptions"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_below="@+id/idAlbumArtWork"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="10dp"
            android:padding="5dp"
            android:src="@drawable/ic_more" />

    </RelativeLayout>
</RelativeLayout>