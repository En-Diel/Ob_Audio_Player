<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/idTracksItems">

    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:id="@+id/idTracksArtWork"
        android:src="@drawable/ic_headphones"
        app:shapeAppearanceOverlay="@style/roundedCornersImageView"
        android:padding="5dp"
        android:scaleType="centerCrop"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Track Title"
        android:id="@+id/idTrackTitle"
        android:layout_toEndOf="@+id/idTracksArtWork"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:layout_toStartOf="@id/idMoreOptions"
        android:maxLines="1"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/artist_name"
        android:id="@+id/idArtistName"
        android:layout_toEndOf="@+id/idTracksArtWork"
        android:textColor="@color/ActionBarTextColor"
        android:textSize="12sp"
        android:layout_below="@+id/idTrackTitle"
        android:layout_marginStart="5dp"
        android:layout_toStartOf="@id/idMoreOptions"
        android:ellipsize="end"
        android:maxLines="1" />

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:id="@+id/idMoreOptions"
        android:src="@drawable/ic_more"
        android:padding="5dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"/>

</RelativeLayout>